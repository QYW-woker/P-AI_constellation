# 环境配置
NODE_ENV=development
PORT=3000

# 数据库配置
DATABASE_URL="postgresql://user:password@localhost:5432/starapp_dev"

# Redis配置
REDIS_URL="redis://localhost:6379"

# JWT配置
JWT_SECRET="your_jwt_secret_key_at_least_32_characters_long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# 加密密钥（32字节的十六进制字符串，共64字符）
ENCRYPTION_KEY="your_encryption_key_64_hex_characters_xxxxxxxxxxxxxxxxxxxxxxxx"

# 订单签名密钥
ORDER_SIGN_SECRET="your_order_sign_secret_key"

# 微信配置
WECHAT_APP_ID="wx_app_id"
WECHAT_APP_SECRET="wx_app_secret"
WECHAT_MCH_ID="wechat_merchant_id"
WECHAT_API_KEY="wechat_api_key"
WECHAT_PAY_SANDBOX=true

# 苹果内购配置
APPLE_BUNDLE_ID="com.yourapp.starapp"
APPLE_SHARED_SECRET="apple_shared_secret"

# 阿里云短信配置
ALIYUN_SMS_ACCESS_KEY_ID="aliyun_access_key_id"
ALIYUN_SMS_ACCESS_KEY_SECRET="aliyun_access_key_secret"
ALIYUN_SMS_SIGN_NAME="星座App"
ALIYUN_SMS_TEMPLATE_CODE="SMS_123456789"

# 短信测试模式（开发环境使用）
SMS_TEST_MODE=true
SMS_TEST_CODE="123456"

# AI服务配置
OPENAI_API_KEY="sk-your-openai-api-key"
AI_MODEL="gpt-4"

# 阿里云OSS配置
ALIYUN_OSS_REGION="oss-cn-shanghai"
ALIYUN_OSS_ACCESS_KEY_ID="oss_access_key_id"
ALIYUN_OSS_ACCESS_KEY_SECRET="oss_access_key_secret"
ALIYUN_OSS_BUCKET="starapp-bucket"

# 极光推送配置
JPUSH_APP_KEY="jpush_app_key"
JPUSH_MASTER_SECRET="jpush_master_secret"

# API基础URL
API_BASE_URL="http://localhost:3000"
